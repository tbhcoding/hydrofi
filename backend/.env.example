SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required for the dashboard's device controls (mode switch, manual dosing).
# Any long random string, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Operators enter it in the dashboard once per browser tab. Left empty,
# the control endpoints refuse every request (503).
ADMIN_API_KEY=

# Optional: powers the AI Assistant chat endpoint (/api/assistant/chat).
# Get a key at https://aistudio.google.com/apikey
# Without this set, the dashboard's Assistant tab falls back to local
# rule-based answers instead of calling the API.
GEMINI_API_KEY=
